<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- On-Page SEO Meta Tags -->
    <title>GUTS & GUYS | Contact Store Studio & Interactive Map</title>
    <meta name="description" content="Contact the GUTS & GUYS flagship menswear studio in Polokwane Central. View boutique hours, interactive store map, and send direct messages.">
    <meta name="keywords" content="contact guts and guys, mens store polokwane, boutique address, interactive map, tailored suits polokwane">

    <!-- Leaflet.js Interactive Map Assets -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="../miscellanous/style.css">
</head>
<body>

    <header>
        <nav>
            <ul>
                <li><a href="../index.html">Home</a></li>
                <li><a href="aboutus.html">About Us</a></li>
                <li><a href="menu.html">Menu</a></li>
                <li><a href="events.html">Events</a></li>
                <li><a href="enquiry.html">Enquiry</a></li>
                <li><a href="contact.html" class="active">Contact</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <section class="page-title">
            <h1>Contact Our Styling Studio</h1>
            <p>Visit our flagship store in Polokwane Central or send a direct customer message.</p>
        </section>

        <section class="contact-grid">
            <article class="contact-info">
                <h2>Flagship Boutique Information</h2>
                <p><strong>Address:</strong> 45 Market Street, Polokwane Central, 0699</p>
                <p><strong>Phone:</strong> +27 (0)15 295 1122</p>
                <p><strong>Email:</strong> info@gutsandguys.co.za</p>
                
                <h3>Interactive Location Map</h3>
                <div id="store-map" style="height: 280px; border-radius: 8px;"></div>
            </article>

            <article class="contact-form-container">
                <h2>Send Us a General Message</h2>
                <form id="contact-form" novalidate>
                    <div class="form-group">
                        <label for="contact-name">Full Name *</label>
                        <input type="text" id="contact-name" name="name" placeholder="e.g. Sipho Ndlovu" required>
                        <span class="error-msg" id="contact-name-error"></span>
                    </div>

                    <div class="form-group">
                        <label for="contact-email">Email Address *</label>
                        <input type="email" id="contact-email" name="email" placeholder="e.g. sipho@example.com" required>
                        <span class="error-msg" id="contact-email-error"></span>
                    </div>

                    <div class="form-group">
                        <label for="contact-phone">Phone Number *</label>
                        <input type="tel" id="contact-phone" name="phone" placeholder="e.g. 0821234567" required>
                        <span class="error-msg" id="contact-phone-error"></span>
                    </div>

                    <div class="form-group">
                        <label for="message-type">Message Type *</label>
                        <select id="message-type" name="type" required>
                            <option value="general">General Inquiry</option>
                            <option value="feedback">Feedback / Customer Service</option>
                            <option value="sponsorship">Sponsorship & Press</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="contact-message">Full Message *</label>
                        <textarea id="contact-message" name="message" rows="5" placeholder="Type your message here..." required></textarea>
                        <span class="error-msg" id="contact-message-error"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Compile & Send Email</button>
                </form>

                <div id="contact-response" class="response-card" style="display:none;"></div>
            </article>
        </section>
    </main>

    <footer class="main-footer">
        <p>&copy; 2026 GUTS & GUYS Men's Apparel. All Rights Reserved.</p>
    </footer>

    <!-- Leaflet.js Engine Script -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="../js/validation.js"></script>
    <script src="../js/main.js"></script>
</body>
</html>
